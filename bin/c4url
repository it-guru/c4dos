#!/usr/bin/env python3
import sys
sys.dont_write_bytecode = True

import os
import importlib
from pathlib import Path
script_dir = Path(__file__).resolve().parent
lib_dir = script_dir / '..' / 'lib'
sys.path.insert(0, str(lib_dir))
sys.path.insert(1, str(script_dir))

__CONFIG__ = "c4dos"

#######################################################################
# Patch  query parameters by -c or --config
new_args = []
skip_next = False

for i, arg in enumerate(sys.argv[1:], start=1):
   if skip_next:
      skip_next = False
      continue
   if arg in ("-c", "--config"):
      if i + 1 < len(sys.argv):
          __CONFIG__ = sys.argv[i + 1]
          skip_next = True
      continue
   if arg.startswith("--config=") or arg.startswith("-c="):
      __CONFIG__ = arg.split("=", 1)[1]
      continue
   new_args.append(arg)
sys.argv = [sys.argv[0]] + new_args
#######################################################################


PROJECT_DIR = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..")
)
if PROJECT_DIR not in sys.path:
  sys.path.insert(0, PROJECT_DIR)

REAL_CURL = "/usr/bin/curl"

auth_key = None
from config import config

if "GLOBAL" in config and "X-AUTHKEY" in config["GLOBAL"]:
  auth_key = config["GLOBAL"]["X-AUTHKEY"]

extra_args = []
#######################################################################
# Forward X-AUTHKEY to curl
if auth_key:
  extra_args.extend(["-H", f"X-AUTHKEY: {auth_key}"])
#######################################################################


#######################################################################
# Forward lang from env to curl call
lang = os.environ.get("LANG")
if lang:
   lang = lang.split("_")[0].split("-")[0].split(".")[0]
   extra_args.extend(["-H", f"Accept-Language: {lang}"])
#######################################################################


# Complete argument list for actual curl invocation
# First item in execv args list must be the executable path/name itself
final_args = [REAL_CURL] + extra_args + sys.argv[1:]

# 5. Replace current Python process image with the actual curl binary
try:
  for proxy_var in ["http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY"]:
     os.environ.pop(proxy_var, None)
  os.execv(REAL_CURL, final_args)
except FileNotFoundError:
  sys.stderr.write(f"Error: System curl binary not found at {REAL_CURL}.\n")
  sys.exit(1)

